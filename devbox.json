{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.12.0/.schema/devbox.schema.json",
  "packages": [
    "bash@latest",
    "curl@latest",
    "git@latest",
    "jq@latest",
    "temurin-bin-21@latest"
  ],
  "shell": {
    "scripts": {
      "check": "./gradlew --console plain --no-daemon --full-stacktrace check",
      "build": "./gradlew --console plain --no-daemon --full-stacktrace build",
      "bump":  "./scripts/bump.sh"
    }
  }
}
